# Swasthya frontend environment template (committed; values never secrets).
# Copy to .env for local builds, or set as build-time env vars on the deploy
# platform (Render static site buildCommand). VITE_-prefixed vars are inlined
# into the bundle at build time.

# API base URL. Empty => same-origin (Vite dev proxy / deployed behind nginx).
# On Render the SPA and API are separate origins, so set this to the backend's
# public URL, e.g. https://swasthya-api.onrender.com
VITE_API_BASE_URL=
