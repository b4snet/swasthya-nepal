<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Test-only encryption key (never used outside testing): the
             EncryptedString cast needs a key for at-rest encryption tests.
             .env.testing shadows .env, so without this the test suite has no
             key at all (MASTER_RULES.md §29: production keys stay in secrets
             management; this is a deterministic test key, not a secret). -->
        <env name="APP_KEY" value="base64:elrVSlD9yBqYxKUzP6wRkT4mN2oF3gH7cXzQ5aJ8bL0="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Tests run on real PostgreSQL, never SQLite (TESTING_STRATEGY.md §0.5,
             MASTER_RULES.md §16.2). The schema is built from migrations on every
             run — the migration test. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="swasthya_test"/>
        <env name="DB_USERNAME" value="swasthya"/>
        <env name="DB_URL" value=""/>
        <!-- DB_PASSWORD is NOT committed: it comes from .env.testing locally and
             from CI environment variables (MASTER_RULES.md §29.2). -->
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- Cheap hashing for tests; production costs come from .env. -->
        <env name="ARGON_MEMORY" value="8192"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="LOG_CHANNEL" value="json"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
