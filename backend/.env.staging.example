# Swasthya staging environment template (STAGING.md §3).
# Copy to .env.staging and fill in real values locally; a real deployment
# injects these from a secrets store. NEVER commit .env.staging — this file
# contains placeholders only (MASTER_RULES.md §28–29, STAGING.md §6).
#
# Staging mirrors production: APP_DEBUG=false, non-owner runtime role
# (swasthya_app), prod-like rate limits, structured JSON logs.

APP_NAME=Swasthya
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.<domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id

LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=<staging-db-host>
DB_PORT=5432
DB_DATABASE=swasthya_staging
DB_USERNAME=swasthya_app        # runtime role — never the migration owner
DB_PASSWORD=<secret>
DB_CHARSET=utf8
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync             # staging v1; database/redis when jobs land
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=<redis-host>
REDIS_PASSWORD=null
REDIS_PORT=6379

# CORS: the staging web origin only. Never '*' with credentials (SECURITY.md §24).
SWASTHYA_CORS_ALLOWED_ORIGINS=https://staging.<domain>
# Rate limits (requests per minute, per IP) — prod-like values.
SWASTHYA_RATE_LIMIT_API=120
SWASTHYA_RATE_LIMIT_AUTH=5
SWASTHYA_RATE_LIMIT_WRITES=60

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@swasthya.local
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3-compatible; documents arrive in a later phase).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Same contract as test: the RLS suite connects as the app role against the
# staging database (TENANCY.md V2 §5, TESTING_STRATEGY.md §database).
RLS_DB_HOST=<staging-db-host>
RLS_DB_PORT=5432
RLS_DB_DATABASE=swasthya_staging
RLS_DB_USERNAME=swasthya_app
RLS_DB_PASSWORD=<secret>

VITE_APP_NAME="${APP_NAME}"
