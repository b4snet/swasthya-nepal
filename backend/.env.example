# Swasthya backend environment template.
# Copy to .env and fill in real values locally. NEVER commit .env.
# Secret values (passwords, keys, tokens) live only in local .env / the secrets store —
# this file contains placeholders only (MASTER_RULES.md §28-29).

# --- Application ---
APP_NAME=Swasthya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the API (used for URLs, CORS defaults, docs).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# --- Hashing ---
# argon2id per SECURITY.md §2 / DATABASE.md §3.4 (fallback: bcrypt).
HASH_DRIVER=argon2id

# --- Logging ---
# Structured JSON logs everywhere (MASTER_RULES.md §18.1).
LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL is the only database; MASTER_RULES.md §5.1) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=swasthya
DB_USERNAME=swasthya
DB_PASSWORD=
DB_CHARSET=utf8
# prefer / require / disable (TLS to PostgreSQL).
DB_SSLMODE=prefer

# --- Sessions / cache / queues ---
# Production uses Redis (ARCHITECTURE.md §2.2). Local defaults are stateless.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis (production: cache, queues, rate limiting, sessions) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- API ---
# CORS: comma-separated allowed origins. Never '*' with credentials (SECURITY.md §24).
SWASTHYA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Rate limits per route class (requests per minute, per IP; per-account limits arrive with auth).
SWASTHYA_RATE_LIMIT_API=300
SWASTHYA_RATE_LIMIT_AUTH=5
SWASTHYA_RATE_LIMIT_WRITES=60

# --- Mail (dev: log) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@swasthya.local
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible; MASTER_RULES.md §3.1) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend build (Vite) ---
VITE_APP_NAME="${APP_NAME}"
